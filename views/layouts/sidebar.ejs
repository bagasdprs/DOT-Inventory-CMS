<% const currentPath = typeof path !== 'undefined' ? path : '/'; %>

<aside
  class="w-64 bg-[#0f172a] text-white flex flex-col min-h-screen transition-all duration-300 border-r border-slate-800"
>
  <div
    class="h-16 flex items-center px-6 border-b border-slate-800 bg-[#0f172a]"
  >
    <div class="flex items-center gap-3">
      <div
        class="w-8 h-8 rounded bg-blue-600 flex items-center justify-center text-white font-bold text-lg"
      >
        <i class="fas fa-cube"></i>
      </div>
      <span class="text-lg font-bold tracking-wide text-gray-100"
        >D.O.T<span class="text-blue-500"> Inventory</span></span
      >
    </div>
  </div>

  <div class="flex-1 overflow-y-auto py-6 px-3 space-y-1">
    <p
      class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2"
    >
      Main Menu
    </p>

    <a
      href="/"
      class="flex items-center px-3 py-2.5 rounded-lg transition-all group <%= currentPath === '/' ? 'bg-blue-600 text-white shadow-md shadow-blue-900/50' : 'text-slate-400 hover:bg-slate-800 hover:text-white' %>"
    >
      <i
        class="<%= currentPath === '/' ? 'text-white' : 'text-slate-500 group-hover:text-white' %> fas fa-chart-pie w-6 text-center transition-colors"
      ></i>
      <span class="font-medium ml-2">Dashboard</span>
    </a>

    <a
      href="/products"
      class="flex items-center px-3 py-2.5 rounded-lg transition-all group <%= currentPath.startsWith('/products') ? 'bg-blue-600 text-white shadow-md shadow-blue-900/50' : 'text-slate-400 hover:bg-slate-800 hover:text-white' %>"
    >
      <i class="fas fa-box w-6 text-center"></i>
      <span class="font-medium ml-2">Products</span>
    </a>

    <a
      href="/categories"
      class="flex items-center px-3 py-2.5 rounded-lg transition-all group <%= currentPath.startsWith('/categories') ? 'bg-blue-600 text-white shadow-md shadow-blue-900/50' : 'text-slate-400 hover:bg-slate-800 hover:text-white' %>"
    >
      <i
        class="<%= currentPath.startsWith('/categories') ? 'text-white' : 'text-slate-500 group-hover:text-white' %> fas fa-tags w-6 text-center transition-colors"
      ></i>
      <span class="font-medium ml-2">Categories</span>
    </a>

    <div class="my-4 border-t border-slate-800"></div>
    <p
      class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2"
    >
      Administration
    </p>

    <a
      href="/users"
      class="flex items-center px-3 py-2.5 rounded-lg transition-all group <%= currentPath.startsWith('/users') ? 'bg-blue-600 text-white shadow-md shadow-blue-900/50' : 'text-slate-400 hover:bg-slate-800 hover:text-white' %>"
    >
      <i
        class="<%= currentPath.startsWith('/users') ? 'text-white' : 'text-slate-500 group-hover:text-white' %> fas fa-users w-6 text-center transition-colors"
      ></i>
      <span class="font-medium ml-2">Users</span>
    </a>
  </div>

  <div class="p-4 border-t border-slate-800 bg-[#0f172a]">
    <div
      class="flex items-center gap-3 p-2 rounded-lg hover:bg-slate-800 transition-colors cursor-pointer"
    >
      <img
        src="https://ui-avatars.com/api/?name=Admin+User&background=3b82f6&color=fff"
        alt="User"
        class="w-9 h-9 rounded-full border border-slate-600"
      />
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium text-white truncate">Bagas Dwiprasandi</p>
        <p class="text-xs text-slate-500 truncate">bagasdwi@dot.co.id</p>
      </div>
      <a href="#" class="text-slate-400 hover:text-red-400 transition-colors"
        ><i class="fas fa-sign-out-alt"></i
      ></a>
    </div>
  </div>
</aside>

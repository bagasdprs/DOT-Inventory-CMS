<div class="space-y-6">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">User Management</h1>
            <p class="text-slate-500 text-sm">Manage access and permissions</p>
        </div>
        <a href="/users/create" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium flex items-center gap-2 transition-colors">
            <i class="fas fa-plus"></i> Add User
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500 font-semibold">
                        <th class="px-6 py-4">User</th>
                        <th class="px-6 py-4">Role</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Joined Date</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    <% users.forEach(user => { %>
                    <tr class="hover:bg-slate-50 transition-colors group">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <img src="https://ui-avatars.com/api/?name=<%= user.name %>&background=random&color=fff&size=128"
                                     alt="<%= user.name %>"
                                     class="w-10 h-10 rounded-full border border-slate-200">
                                <div>
                                    <div class="font-medium text-slate-900"><%= user.name %></div>
                                    <div class="text-xs text-slate-500"><%= user.email %></div>
                                </div>
                            </div>
                        </td>

                        <td class="px-6 py-4">
                            <%
                                let badgeClass = 'bg-slate-100 text-slate-600';
                                if(user.role === 'admin') badgeClass = 'bg-purple-100 text-purple-700 border border-purple-200';
                                if(user.role === 'manager') badgeClass = 'bg-blue-100 text-blue-700 border border-blue-200';
                            %>
                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold capitalize <%= badgeClass %>">
                                <%= user.role %>
                            </span>
                        </td>

                        <td class="px-6 py-4">
                            <div class="flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                <span class="text-slate-600">Active</span>
                            </div>
                        </td>

                        <td class="px-6 py-4 text-slate-500">
                            <%= new Date(user.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </td>

                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a href="/users/edit/<%= user.id %>" class="p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="Edit">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <a href="/users/delete/<%= user.id %>" onclick="return confirm('Hapus user <%= user.name %>?')" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    <% }) %>

                    <% if(users.length === 0) { %>
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-slate-500">
                            <div class="flex flex-col items-center">
                                <i class="fas fa-users-slash text-4xl mb-3 text-slate-300"></i>
                                <p>No users found yet.</p>
                            </div>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
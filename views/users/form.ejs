<div class="max-w-2xl mx-auto">
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-800"><%= title %></h1>
            <p class="text-slate-500 text-sm">Set user credentials and role</p>
        </div>
        <a href="/users" class="text-slate-500 hover:text-slate-700 text-sm font-medium flex items-center gap-1">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8">
        <form action="<%= type === 'create' ? '/users' : '/users/update/' + user.id %>" method="POST">

            <div class="mb-5">
                <label class="block text-sm font-medium text-slate-700 mb-1">Full Name <span class="text-red-500">*</span></label>
                <input type="text" name="name" required
                       value="<%= user ? user.name : '' %>"
                       class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                       placeholder="e.g. John Doe">
            </div>

            <div class="mb-5">
                <label class="block text-sm font-medium text-slate-700 mb-1">Email Address <span class="text-red-500">*</span></label>
                <input type="email" name="email" required
                       value="<%= user ? user.email : '' %>"
                       class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                       placeholder="name@company.com">
            </div>

            <div class="mb-5">
                <label class="block text-sm font-medium text-slate-700 mb-1">
                    <%= type === 'create' ? 'Password' : 'New Password (Optional)' %>
                    <% if(type === 'create') { %><span class="text-red-500">*</span><% } %>
                </label>
                <div class="relative">
                    <input type="password" name="password"
                           <%= type === 'create' ? 'required' : '' %>
                           pattern="^[A-Z].*(?=.*\d)(?=.*[\W_]).{6,}$"
                           title="Harus diawali Huruf Besar, minimal 8 karakter, mengandung angka dan simbol."
                           class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                           placeholder="••••••••">
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400">
                        <i class="fas fa-lock text-xs"></i>
                    </div>
                </div>
                <p class="text-xs text-slate-500 mt-2">
                    <i class="fas fa-info-circle text-blue-500 mr-1"></i>
                    Min 8 chars, start with Uppercase, must have Number & Symbol.
                </p>
            </div>

            <div class="mb-8">
                <label class="block text-sm font-medium text-slate-700 mb-1">Role <span class="text-red-500">*</span></label>
                <select name="role" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:outline-none focus:border-blue-500 bg-white">
                    <option value="staff" <%= user && user.role === 'staff' ? 'selected' : '' %>>Staff</option>
                    <option value="manager" <%= user && user.role === 'manager' ? 'selected' : '' %>>Manager</option>
                    <option value="admin" <%= user && user.role === 'admin' ? 'selected' : '' %>>Admin</option>
                </select>
            </div>

            <div class="pt-5 border-t border-slate-100 flex gap-3">
                <button type="submit" class="bg-blue-600 text-white px-6 py-2.5 rounded-lg hover:bg-blue-700 font-medium transition-colors shadow-lg shadow-blue-500/30">
                    <%= type === 'create' ? 'Create User' : 'Save Changes' %>
                </button>
                <a href="/users" class="px-6 py-2.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 font-medium transition-colors">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>
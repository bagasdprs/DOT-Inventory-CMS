<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | D.O.T Inventory</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>

<body class="bg-white h-screen overflow-hidden">

  <div class="flex h-full w-full">
    <div class="hidden md:flex w-1/2 bg-slate-200 flex-col justify-center items-center relative overflow-hidden">

      <div
        class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-blue-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob">
      </div>
      <div
        class="absolute bottom-[-10%] right-[-10%] w-96 h-96 bg-purple-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000">
      </div>

      <div class="z-10 text-center px-12 animate__animated animate__fadeIn">
        <div class="mb-8 flex items-center justify-center gap-3">
          <div class="bg-blue-600 p-2 rounded-lg text-white">
            <i class="fas fa-box text-2xl"></i>
          </div>
          <h1 class="text-3xl font-bold tracking-tight text-slate-800">D.O.T Inventory</h1>
        </div>

        <div class="w-full max-w-lg mx-auto mb-8">
          <lottie-player src="https://lottie.host/9b949601-b358-44f5-8a7f-e63bfa368173/bYjb2sgHCF.json"
            background="transparent" speed="1" style="width: 100%; height: 350px;" loop autoplay>
          </lottie-player>
        </div>

        <h2 class="text-2xl font-bold mb-2 text-slate-700">Streamline Your Assets</h2>

        <p class="text-slate-500 text-sm leading-relaxed max-w-sm mx-auto">
          Manage your inventory efficiently with real-time tracking, analytics, and seamless team collaboration.
        </p>
      </div>
    </div>
    <div class="w-full md:w-1/2 flex items-center justify-center p-8 md:p-12 relative">

      <a href="#" class="absolute top-8 left-8 text-slate-400 hover:text-slate-600 transition-colors md:hidden">
        <i class="fas fa-arrow-left"></i>
      </a>

      <div class="w-full max-w-sm animate__animated animate__fadeInRight">

        <div class="md:hidden flex items-center gap-2 mb-8 text-slate-800">
          <div class="bg-blue-600 p-1.5 rounded text-white">
            <i class="fas fa-box"></i>
          </div>
          <span class="font-bold text-lg">InventoryPro</span>
        </div>

        <div class="mb-8">
          <h2 class="text-3xl font-bold text-slate-900 mb-2">Welcome Back</h2>
          <p class="text-slate-500 text-sm">Please enter your details to sign in.</p>
        </div>

        <% if (typeof error !== 'undefined' && error.length > 0) { %>
        <div
          class="bg-red-50 text-red-600 px-4 py-3 rounded-lg text-sm mb-6 flex items-center gap-2 border border-red-100 animate__animated animate__shakeX">
          <i class="fas fa-exclamation-circle"></i>
          <%= error %>
        </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success.length > 0) { %>
        <div
          class="bg-green-50 text-green-600 px-4 py-3 rounded-lg text-sm mb-6 flex items-center gap-2 border border-green-100">
          <i class="fas fa-check-circle"></i>
          <%= success %>
        </div>
        <% } %>

        <form action="/auth/login" method="POST">
          <div class="mb-5">
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Email Address</label>
            <div class="relative">
              <input type="email" name="email" required value="<%= typeof email !== 'undefined' ? email : '' %>"
                class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 pl-10 transition-all text-sm"
                placeholder="name@company.com">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <i class="fas fa-envelope text-xs"></i>
              </div>
            </div>
          </div>

          <div class="mb-2">
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Password</label>
            <div class="relative">
              <input type="password" name="password" required
                class="w-full px-4 py-2.5 border border-slate-200 rounded-lg focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 pl-10 transition-all text-sm"
                placeholder="••••••••">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <i class="fas fa-lock text-xs"></i>
              </div>
            </div>
          </div>

          <div class="flex justify-end mb-6">
            <a href="#" class="text-xs font-medium text-blue-600 hover:text-blue-700 hover:underline">Forgot
              Password?</a>
          </div>

          <button type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-lg transition-all transform hover:scale-[1.02] active:scale-[0.98] shadow-lg shadow-blue-500/30">
            Sign In
          </button>
        </form>

        <div class="mt-8 text-center">
          <p class="text-sm text-slate-500">
            Don't have an account?
            <a href="/auth/register" class="font-medium text-blue-600 hover:text-blue-700 hover:underline">Sign up for
              free</a>
          </p>
        </div>

        <div class="mt-12 text-center text-xs text-slate-400">
          &copy; 2026 InventoryPro. All rights reserved.
        </div>
      </div>
    </div>
  </div>

  <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
    const errorMessage = "<%= typeof error !== 'undefined' ? error : '' %>";

    if (errorMessage) {
      Swal.fire({
        icon: 'error',
        title: 'Login Gagal',
        text: errorMessage,
        confirmButtonColor: '#2563EB',
        confirmButtonText: 'Coba Lagi'
      });
    }
  </script>
  <script>
  const oldEmail = "<%= typeof oldEmail !== 'undefined' ? oldEmail : '' %>";
  if (oldEmail) {
    document.querySelector('input[name="email"]').value = oldEmail;
  }
</script>

</body>

</html>
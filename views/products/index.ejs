<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-800">Products</h1>
        <p class="text-slate-500 text-sm">Manage your inventory items</p>
    </div>
    <a href="/products/create" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg font-medium shadow-sm transition-all flex items-center gap-2">
        <i class="fas fa-plus"></i> Add Product
    </a>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">

    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex justify-between items-center">
        <div>
            <div class="text-slate-500 text-sm font-medium mb-1">Total Products</div>
            <div class="text-3xl font-bold text-slate-800"><%= stats.totalProducts %></div>
        </div>
        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center text-xl">
            <i class="fas fa-box"></i>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex justify-between items-center">
        <div>
            <div class="text-slate-500 text-sm font-medium mb-1">Total Asset Value</div>
            <div class="text-3xl font-bold text-slate-800">
                Rp <%= Number(stats.totalValue).toLocaleString('id-ID') %>
            </div>
        </div>
        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-lg flex items-center justify-center text-xl">
            <i class="fas fa-money-bill-wave"></i>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex justify-between items-center">
        <div>
            <div class="text-slate-500 text-sm font-medium mb-1">Low Stock Items</div>
            <div class="text-3xl font-bold <%= stats.lowStock > 0 ? 'text-red-500' : 'text-slate-800' %>">
                <%= stats.lowStock %>
            </div>
        </div>
        <div class="w-12 h-12 <%= stats.lowStock > 0 ? 'bg-red-50 text-red-600' : 'bg-slate-50 text-slate-400' %> rounded-lg flex items-center justify-center text-xl">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">

    <div class="p-4 border-b border-slate-100 flex gap-3">
        <input type="text" placeholder="Search products..." class="w-full max-w-sm px-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 text-slate-600 text-xs uppercase tracking-wider font-semibold">
                    <th class="p-4 border-b border-slate-100">Product Name</th>
                    <th class="p-4 border-b border-slate-100">Category</th>
                    <th class="p-4 border-b border-slate-100">Price</th>
                    <th class="p-4 border-b border-slate-100">Stock</th>
                    <th class="p-4 border-b border-slate-100">Status</th>
                    <th class="p-4 border-b border-slate-100 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="text-sm divide-y divide-slate-100">

                <% if (products && products.length > 0) { %>
                    <% products.forEach(product => { %>
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="p-4 font-medium text-slate-800">
                            <%= product.name %>
                            <div class="text-xs text-slate-400 font-normal mt-0.5"><%= product.description ? product.description.substring(0, 30) + '...' : '-' %></div>
                        </td>
                        <td class="p-4 text-slate-600"><%= product.category ? product.category.name : 'Uncategorized' %></td>
                        <td class="p-4 font-medium text-slate-800">Rp <%= Number(product.price).toLocaleString('id-ID') %></td>
                        <td class="p-4 text-slate-600"><%= product.stock %></td>
                        <td class="p-4">
                            <% if (product.stock > 10) { %>
                                <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-medium border border-green-200">
                                    In Stock
                                </span>
                            <% } else if (product.stock > 0) { %>
                                <span class="bg-orange-100 text-orange-700 px-3 py-1 rounded-full text-xs font-medium border border-orange-200">
                                    Low Stock
                                </span>
                            <% } else { %>
                                <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-xs font-medium border border-red-200">
                                    Out of Stock
                                </span>
                            <% } %>
                        </td>
                        <td class="p-4 text-right">
                            <a href="/products/edit/<%= product.id %>" class="text-blue-600 hover:text-blue-800 mr-3">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="/products/delete/<%= product.id %>" class="text-red-500 hover:text-red-700" onclick="return confirm('Are you sure?')">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="p-8 text-center text-slate-500">
                            <div class="flex flex-col items-center justify-center">
                                <i class="fas fa-box-open text-4xl text-slate-300 mb-3"></i>
                                <p>No products found.</p>
                                <a href="/products/create" class="text-blue-500 text-sm mt-2 hover:underline">Create your first product</a>
                            </div>
                        </td>
                    </tr>
                <% } %>

            </tbody>
        </table>
    </div>

    <div class="p-4 border-t border-slate-100 flex justify-between items-center text-sm text-slate-500">
        <span>Showing 1-10 of <%= products.length %> results</span>
        <div class="flex gap-2">
            <button class="px-3 py-1 border rounded hover:bg-slate-50" disabled>Previous</button>
            <button class="px-3 py-1 border rounded hover:bg-slate-50">Next</button>
        </div>
    </div>
</div>
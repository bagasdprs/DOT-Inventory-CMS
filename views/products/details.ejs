<!-- BREADCRUMB NAVIGATION -->
<div class="mb-8">
  <nav class="flex items-center gap-2 text-sm text-gray-600">
    <a href="/products" class="hover:text-blue-600 transition">Products</a>
    <span>/</span>
    <span class="text-gray-900 font-medium"><%= product.name %></span>
  </nav>
</div>

<!-- MAIN CONTENT: 2 COLUMNS -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl">

  <!-- ==================== KOLOM KIRI: IMAGE ==================== -->
  <div class="space-y-4">
    <div class="relative aspect-square bg-gray-100 rounded-2xl overflow-hidden border border-gray-200">

      <!-- PRODUCT IMAGE -->
      <% if (product.imageUrl) { %>
        <img
          src="<%= product.imageUrl %>"
          alt="<%= product.name %>"
          class="w-full h-full object-cover"
        />
      <% } else { %>
        <!-- FALLBACK: Kalau ga ada gambar -->
        <div class="w-full h-full flex items-center justify-center">
          <i class="fas fa-box text-8xl text-gray-300"></i>
        </div>
      <% } %>

      <!-- STOCK STATUS BADGE (Floating di kanan atas) -->
      <div class="absolute top-4 right-4">
        <span class="
          inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold border-2
          <% if (stockStatus.color === 'green') { %>
            bg-green-100 text-green-800 border-green-200
          <% } else if (stockStatus.color === 'yellow') { %>
            bg-yellow-100 text-yellow-800 border-yellow-200
          <% } else { %>
            bg-red-100 text-red-800 border-red-200
          <% } %>
        ">
          <i class="fas fa-circle text-xs"></i>
          <%= stockStatus.text %>
        </span>
      </div>
    </div>
  </div>

  <!-- ==================== KOLOM KANAN: DETAILS ==================== -->
  <div class="space-y-8">

    <!-- 1. HEADER SECTION -->
    <div class="space-y-3">

      <!-- Category Badge -->
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-2 px-3 py-1 bg-blue-50 text-blue-700 rounded-lg text-sm font-medium">
          <i class="<%= product.category?.icon || 'fas fa-tag' %>"></i>
          <%= product.category?.name || 'Uncategorized' %>
        </span>
      </div>

      <!-- Product Name -->
      <h1 class="text-4xl font-bold text-gray-900 leading-tight">
        <%= product.name %>
      </h1>

      <!-- Product ID -->
      <p class="text-sm text-gray-500">
        #ID: <%= product.id %>
      </p>
    </div>

    <!-- 2. PRICING SECTION -->
    <div class="py-4 border-y border-gray-200">
      <p class="text-5xl font-bold text-blue-600">
        Rp <%= product.price.toLocaleString('id-ID') %>
      </p>
    </div>

    <!-- 3. DESCRIPTION SECTION -->
    <div class="space-y-3">
      <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500">
        Description
      </h2>
      <p class="text-base text-gray-700 leading-relaxed">
        <%= product.description || 'No description available.' %>
      </p>
    </div>

    <!-- 4. INVENTORY INFO CARD -->
    <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 space-y-4">
      <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wide flex items-center gap-2">
        <i class="fas fa-box-open text-blue-600"></i>
        Inventory Information
      </h3>

      <div class="space-y-3">
        <!-- Stock -->
        <div class="flex justify-between items-center">
          <span class="text-sm text-gray-600">Sisa Stok</span>
          <span class="text-base font-semibold text-gray-900">
            <%= product.stock %> units
          </span>
        </div>

        <!-- SKU (kalau ada) -->
        <% if (product.sku) { %>
        <div class="flex justify-between items-center">
          <span class="text-sm text-gray-600">SKU</span>
          <span class="text-base font-mono text-gray-900">
            <%= product.sku %>
          </span>
        </div>
        <% } %>

        <!-- Last Update -->
        <div class="flex justify-between items-center">
          <span class="text-sm text-gray-600">Terakhir Update</span>
          <span class="text-base text-gray-900">
            <%= new Date(product.updatedAt).toLocaleDateString('id-ID', {
              day: 'numeric',
              month: 'short',
              year: 'numeric'
            }) %>
          </span>
        </div>
      </div>
    </div>

    <!-- 5. ACTION BUTTONS -->
    <div class="flex gap-4 pt-4">
      <!-- Edit Product Button -->
      <a
        href="/products/edit/<%= product.id %>"
        class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-all hover:scale-105 hover:shadow-lg"
      >
        <i class="fas fa-edit"></i>
        Edit Product
      </a>

      <!-- Back Button -->
      <a
        href="/products"
        class="px-6 py-3 bg-gray-200 text-gray-700 font-semibold rounded-lg hover:bg-gray-300 transition-all"
      >
        <i class="fas fa-arrow-left"></i>
        Kembali
      </a>
    </div>

  </div>
</div>
<div class="space-y-6">

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex items-center justify-between">
            <div>
                <p class="text-slate-500 text-sm font-medium mb-1">Total Products</p>
                <h3 class="text-2xl font-bold text-slate-800"><%= stats.totalProducts %></h3>
            </div>
            <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center text-xl">
                <i class="fas fa-box"></i>
            </div>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex items-center justify-between">
            <div>
                <p class="text-slate-500 text-sm font-medium mb-1">Inventory Value</p>
                <h3 class="text-2xl font-bold text-slate-800">Rp <%= Number(stats.totalValue).toLocaleString('id-ID') %></h3>
            </div>
            <div class="w-12 h-12 bg-green-50 text-green-600 rounded-lg flex items-center justify-center text-xl">
                <i class="fas fa-money-bill-wave"></i>
            </div>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex items-center justify-between">
            <div>
                <p class="text-slate-500 text-sm font-medium mb-1">Low Stock Items</p>
                <h3 class="text-2xl font-bold text-red-600"><%= stats.lowStockCount %></h3>
            </div>
            <div class="w-12 h-12 bg-red-50 text-red-600 rounded-lg flex items-center justify-center text-xl">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex items-center justify-between">
            <div>
                <p class="text-slate-500 text-sm font-medium mb-1">Total Categories</p>
                <h3 class="text-2xl font-bold text-slate-800"><%= stats.totalCategories %></h3>
            </div>
            <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-lg flex items-center justify-center text-xl">
                <i class="fas fa-tags"></i>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex justify-between items-center">
                <h3 class="font-bold text-slate-800">Recently Added Products</h3>
                <a href="/products" class="text-sm text-blue-600 hover:underline">View All</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-slate-50 text-slate-500 text-xs uppercase">
                        <tr>
                            <th class="px-5 py-3">Product Name</th>
                            <th class="px-5 py-3">Price</th>
                            <th class="px-5 py-3">Stock</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        <% recentProducts.forEach(product => { %>
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-3 font-medium text-slate-800">
                                <%= product.name %>
                                <div class="text-xs text-slate-400 font-normal"><%= product.category ? product.category.name : 'No Category' %></div>
                            </td>
                            <td class="px-5 py-3">Rp <%= Number(product.price).toLocaleString('id-ID') %></td>
                            <td class="px-5 py-3">
                                <span class="px-2 py-1 rounded text-xs font-medium <%= product.stock > 10 ? 'bg-green-100 text-green-700' : 'bg-orange-100 text-orange-700' %>">
                                    <%= product.stock %> pcs
                                </span>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex items-center gap-2">
                <i class="fas fa-bell text-red-500"></i>
                <h3 class="font-bold text-slate-800">Low Stock Alerts</h3>
            </div>
            <div class="p-0">
                <% if (lowStockProducts.length > 0) { %>
                    <% lowStockProducts.forEach(product => { %>
                    <div class="flex items-center justify-between p-4 border-b border-slate-50 hover:bg-red-50/50 transition-colors">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-box-open"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-semibold text-slate-800"><%= product.name %></h4>
                                <p class="text-xs text-slate-500">SKU: <%= product.id %></p>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-red-600 font-bold text-sm"><%= product.stock %> left</div>
                            <a href="/products/edit/<%= product.id %>" class="text-xs text-blue-500 hover:underline">Restock</a>
                        </div>
                    </div>
                    <% }) %>
                <% } else { %>
                    <div class="p-8 text-center text-slate-500">
                        <i class="fas fa-check-circle text-green-500 text-3xl mb-2"></i>
                        <p>All stocks are healthy!</p>
                    </div>
                <% } %>
            </div>
        </div>

    </div>
</div>
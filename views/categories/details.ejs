<div class="space-y-6">

    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div class="flex items-center gap-4">
            <a href="/categories"
                class="w-10 h-10 flex items-center justify-center bg-white border border-slate-200 rounded-lg text-slate-500 hover:bg-slate-50 hover:text-blue-600 transition-colors shadow-sm">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-slate-800"><%= category.name %></h1>
                <p class="text-slate-500 text-sm">Inventory Category Detail</p>
            </div>
        </div>

        <div class="flex gap-3">
            <a href="/categories/edit/<%= category.id %>"
                class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 text-slate-600 rounded-lg text-sm font-medium hover:bg-slate-50 hover:text-blue-600 transition-all shadow-sm">
                <i class="fas fa-pen text-xs"></i> Edit
            </a>
            <a href="/categories/delete/<%= category.id %>" onclick="return confirm('Yakin hapus kategori ini?')"
                class="flex items-center gap-2 px-4 py-2 bg-white border border-red-200 text-red-600 rounded-lg text-sm font-medium hover:bg-red-50 transition-all shadow-sm">
                <i class="fas fa-trash text-xs"></i> Delete
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex items-center">
            <div class="w-12 h-12 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-xl mr-4">
                <i class="fas fa-boxes"></i>
            </div>
            <div>
                <p class="text-slate-500 text-sm font-medium">Total Items</p>
                <h3 class="text-2xl font-bold text-slate-800"><%= stats.totalItems %> <span
                        class="text-sm font-normal text-slate-400">SKU</span></h3>
            </div>
        </div>

        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex items-center">
            <div
                class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl mr-4">
                <i class="fas fa-wallet"></i>
            </div>
            <div>
                <p class="text-slate-500 text-sm font-medium">Asset Value</p>
                <h3 class="text-2xl font-bold text-slate-800">
                    <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(stats.totalAssetValue) %>
                </h3>
            </div>
        </div>

        <div
            class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex items-center <%= stats.lowStockCount > 0 ? 'border-l-4 border-l-orange-500' : 'border-l-4 border-l-emerald-500' %>">
            <div
                class="w-12 h-12 rounded-full <%= stats.lowStockCount > 0 ? 'bg-orange-50 text-orange-600' : 'bg-emerald-50 text-emerald-600' %> flex items-center justify-center text-xl mr-4">
                <i class="fas fa-heartbeat"></i>
            </div>
            <div>
                <p class="text-slate-500 text-sm font-medium">Low Stock Items</p>
                <h3 class="text-2xl font-bold <%= stats.lowStockCount > 0 ? 'text-orange-600' : 'text-slate-800' %>">
                    <%= stats.lowStockCount %>
                </h3>
                <% if(stats.lowStockCount > 0) { %>
                <span class="text-xs text-orange-500 font-semibold">Needs Attention</span>
                <% } else { %>
                <span class="text-xs text-emerald-500 font-semibold">Healthy</span>
                <% } %>
            </div>
        </div>
    </div>

    <% if (stats.lowStockCount > 0) { %>
    <div class="bg-orange-50 border border-orange-200 rounded-xl p-4 flex items-center justify-between shadow-sm">
        <div class="flex items-center gap-3">
            <i class="fas fa-exclamation-triangle text-orange-500 text-lg"></i>
            <div>
                <p class="text-orange-800 font-semibold text-sm">Low Stock Alert</p>
                <p class="text-orange-600 text-xs">There are <%= stats.lowStockCount %> items running low below safety
                    levels.</p>
            </div>
        </div>
        <button
            class="px-4 py-2 bg-white text-orange-600 text-sm font-bold rounded-lg border border-orange-200 hover:bg-orange-100 transition-colors shadow-sm">
            Restock
        </button>
    </div>
    <% } %>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
            <h3 class="font-bold text-slate-700">Products List</h3>
            <span class="text-xs text-slate-500 bg-slate-200 px-2 py-1 rounded-full"><%= category.products.length %>
                Items</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 text-slate-500 text-xs uppercase font-semibold">
                    <tr>
                        <th class="px-6 py-4">Product Name</th>
                        <th class="px-6 py-4">Price</th>
                        <th class="px-6 py-4">Stock Status</th>
                        <th class="px-6 py-4">Last Update</th>
                        <th class="px-6 py-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% category.products.forEach(product => { %>
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <img src="<%= product.image_url || 'https://via.placeholder.com/50' %>"
                                    class="w-10 h-10 rounded-lg object-cover border border-slate-200 bg-slate-50"
                                    alt="img">
                                <div>
                                    <div class="font-bold text-slate-700 text-sm"><%= product.name %></div>
                                    <div class="text-xs text-slate-400 font-mono"><%= product.sku || '-' %></div>
                                </div>
                            </div>
                        </td>

                        <td class="px-6 py-4 font-medium text-slate-700">
                            <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(product.price) %>
                        </td>

                        <td class="px-6 py-4">
                            <% if (product.stock == 0) { %>
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                Out of Stock
                            </span>
                            <% } else if (product.stock <= 10) { %>
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                Low: <%= product.stock %>
                            </span>
                            <% } else { %>
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                                <%= product.stock %> Units
                            </span>
                            <% } %>
                        </td>

                        <td class="px-6 py-4 text-sm text-slate-500">
                            <%= new Date(product.updated_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </td>

                        <td class="px-6 py-4 text-right">
                            <a href="/products/edit/<%= product.id %>"
                                class="text-slate-400 hover:text-blue-600 transition-colors">
                                <i class="fas fa-edit"></i>
                            </a>
                        </td>
                    </tr>
                    <% }) %>

                    <% if(category.products.length === 0) { %>
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-slate-400">
                            <div
                                class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-3 text-slate-300">
                                <i class="fas fa-box-open text-2xl"></i>
                            </div>
                            <p class="text-sm">No products in this category yet.</p>
                            <a href="/products/create"
                                class="mt-2 inline-block text-blue-600 text-sm font-medium hover:underline">Add
                                Product</a>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>